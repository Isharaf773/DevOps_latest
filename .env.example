# ---------------------------------------------------------------
# Copy to .env and change the values:   cp .env.example .env
# .env is git-ignored - never commit real secrets.
# ---------------------------------------------------------------

# --- MongoDB (use letters/digits only so the password is URL-safe) ---
MONGO_USER=admin
MONGO_PASSWORD=change_me_mongo_password
MONGO_DB=fooddb

# --- Backend ---
NODE_ENV=production
JWT_SECRET=change_me_to_a_long_random_string
STRIPE_SECRET_KEY=

# --- Public URLs (what the BROWSER uses to reach the services) ---
# Local:  http://localhost:4000 / http://localhost:3000
# AWS:    http://<elastic-ip>:4000 / http://<elastic-ip>:3000  (Terraform writes these for you)
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Images (Jenkins builds and tags these) ---
IMAGE_NAMESPACE=foodapp
IMAGE_TAG=latest
