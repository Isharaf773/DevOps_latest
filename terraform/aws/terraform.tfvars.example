# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
aws_region          = "ap-south-1"
allowed_ssh_cidrs   = ["203.0.113.10/32"] # <- your public IP + /32
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
repo_url            = "https://github.com/YOUR_USER/YOUR_REPO.git"
repo_branch         = "main"
image_namespace     = "your-dockerhub-username"
image_tag           = "latest"
# stripe_secret_key = "sk_test_..."
